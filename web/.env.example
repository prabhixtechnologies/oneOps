# API base URL (without /api/v1 suffix)
VITE_API_URL=http://localhost:8080

# Razorpay key id (test mode)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Set to true only when Google SSO is configured server-side
VITE_GOOGLE_SSO_ENABLED=false

# Admin build only (APP=admin). Where "Open in OneOps" sends staff to look at a customer's data,
# since the admin console has no tenant pages of its own. Defaults to the production host, so a
# local admin build left unset would send you to production.
VITE_ONEOPS_URL=http://localhost:5173
