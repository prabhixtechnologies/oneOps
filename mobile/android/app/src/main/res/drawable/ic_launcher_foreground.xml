<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: the Prabhix "PA" monogram, identical geometry to the web mark in
  marketing/src/components/logo-mark.tsx and web/public/favicon.svg.

  The source art is drawn in a 36x36 space where the monogram occupies x 10..31, y 12..24. An
  adaptive icon is a 108x108 canvas of which only the central 66dp circle is guaranteed visible —
  launchers crop the rest to whatever mask the device uses. So the art is scaled 2.6x and recentred
  on (54,54) rather than pasted in at source size, which would leave it tiny in the corner.

  Scaled extent is 54.6 x 31.2, giving a half-diagonal of ~31.4 against the 33dp safe radius.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.6"
        android:scaleY="2.6"
        android:translateX="0.7"
        android:translateY="7.2">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M10,24V12h4.2c3.2,0 5,1.8 5,3.7 0,1.9 -1.9,3.8 -5,3.8v4.5H10zm4.2,-6.5h2c1.1,0 1.8,-0.6 1.8,-1.5 0,-0.9 -0.7,-1.5 -1.8,-1.5h-2z" />
        <path
            android:fillColor="#22D3EE"
            android:pathData="M22.5,12h3.5l5,12h-3.7l-0.9,-2.3h-4.5l-0.9,2.3H17l5.5,-12zm2.2,7.1l-1.5,-3.8 -1.5,3.8h3z" />
    </group>
</vector>
