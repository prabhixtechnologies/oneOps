// Copy to Config.xcconfig, which is gitignored, then run `xcodegen generate`.
//
// Only settings that differ per developer belong here. Everything shared — bundle ids, app names,
// deep-link schemes, entitlements — is in project.yml, so that it is reviewable and identical on
// every machine. In particular do not set PRODUCT_BUNDLE_IDENTIFIER here: there are two apps and
// project.yml gives each its own.
//
// The $() in the URLs below is not a typo. xcconfig treats // as the start of a comment, including
// inside a value, so the empty substitution breaks up the // in http:// and the rest of the line
// survives.

// Simulator builds ignore this and use localhost. A physical device needs your machine's LAN
// address, because localhost on the phone is the phone.
API_BASE_URL = http:/$()/localhost:8080/api/v1
// Physical device: http:/$()/192.168.x.x:8080/api/v1

IDENTITY_ISSUER = http:/$()/localhost:8081
// Physical device: http:/$()/192.168.x.x:8081
// Production: https:/$()/api.prabhixtechnologies.com

// From Xcode > Settings > Accounts, or `security find-identity -v -p codesigning`. Leave empty to
// build for the simulator only; a device build needs it.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
