<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!--
          4.1.1. The 3.5.x line it came from is end of life — open-source support ended 30 June 2026 —
          so this is a security floor, not a chase for new features. The JDK moved first, in its own
          step, so that a failure here has one candidate cause rather than two.
        -->
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.prabhix</groupId>
    <artifactId>platform</artifactId>
    <version>1.0.0</version>
    <name>prabhix-platform</name>
    <description>Prabhix Technologies enterprise platform API</description>

    <properties>
        <!--
          25, the current LTS. Not a language-feature decision — nothing in the codebase needs a
          syntax newer than 17 — but a support one: 21's free updates end well before 25's, and the
          runtime gains matter more than the syntax. Compact object headers alone recover a
          meaningful slice of a 4 GiB box shared by four JVMs.

          Still builds on an older JDK with -Djava.version=17, since <release> is all that this sets.
          The Android modules stay on 17 for an unrelated reason: the Android Gradle Plugin pins the
          JDK range it accepts and rejects anything newer outright.
        -->
        <java.version>25</java.version>
        <build.dir>${project.basedir}/target</build.dir>
        <jjwt.version>0.12.6</jjwt.version>
        <!-- Published from Identity/client by that repository's CI; see <repositories> below. -->
        <identity.starter.version>1.0.0</identity.starter.version>
        <!--
          3.x is the line built against Boot 4; 2.8.x reads
          org.springframework.boot.autoconfigure.web.servlet.WebMvcProperties, which Boot 4 moved, so
          SwaggerConfig cannot be introspected and the context refuses to start. Not a compile error,
          since springdoc is only ever on the classpath — the integration tests are what catch it.
        -->
        <springdoc.version>3.1.0</springdoc.version>
        <!--
          Testcontainers is version-managed by the Boot parent from 4.x on, so the pin is gone and the
          modules inherit it. Worth knowing that 2.x renamed every module to carry a testcontainers-
          prefix and dropped the self-referential generics.
        -->
        <jsoup.version>1.18.3</jsoup.version>
        <ognl.version>3.3.4</ognl.version>
        <openhtmltopdf.version>1.0.10</openhtmltopdf.version>
        <awssdk.version>2.29.52</awssdk.version>
        <logstash.encoder.version>9.0</logstash.encoder.version>
    </properties>

    <dependencies>
        <!-- Web / API -->
        <!--
          webmvc, not web. spring-boot-starter-web still resolves but is deprecated for removal: it is
          the classic aggregate, and pulls in HTTP clients and JSON support whether or not they are
          wanted, which is the coupling the 4.x split exists to undo.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!--
          webmvc brings no JSON library of its own, so the mapper that serialises every response has
          to be asked for. Leaving it out builds cleanly and produces controllers that cannot write
          their return values.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <!--
          Nor does webmvc auto-configure an HTTP client any more, and RestClient.Builder is what the
          identity starter builds its JWKS and internal-API client from. Without this the context
          cannot be built at all, which is a strange way for "cannot verify a token" to present itself.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          Boot 4 does not auto-configure CloudWatch export. The registry is on the classpath so
          CloudWatchMetricsConfiguration can build it when CLOUDWATCH_METRICS=true (or profile
          cloudwatch). Off by default — tests must not open an AWS client.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-cloudwatch2</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
          The starter, not flyway-core alone: Boot 4 moved Flyway's auto-configuration out of the
          monolithic autoconfigure jar into spring-boot-flyway, which only the starter brings. With
          bare flyway-core the migrations silently stop running at startup.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Cache / coordination -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
          The only way a bearer token gets into this API. The starter verifies Prabhix Identity's
          RS256 tokens against its published JWKS, mirrors identity users into the local users table
          through the UserMirrorStore this application provides, and wraps identity's internal API.
          Nothing here signs or verifies a bearer token itself any more: a product that could verify
          with a shared secret could also mint with it, which is the property the split removed.
        -->
        <dependency>
            <groupId>com.prabhix</groupId>
            <artifactId>identity-spring-boot-starter</artifactId>
            <version>${identity.starter.version}</version>
        </dependency>
        <!--
          Kept for what is not a bearer token: chat visitor tokens (ChatTokenService), and the signed
          JWTs the FCM and APNs push providers authenticate to Google and Apple with. The starter has
          its own jjwt dependency for verification; this one is for this application's own signing.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Mail: SMTP send + IMAP fetch + MIME parsing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
        </dependency>

        <!-- HTML email templating -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Mail bodies are rendered by a plain Thymeleaf TemplateEngine over template strings
             held in the database, which evaluates expressions with OGNL. thymeleaf-spring6
             excludes OGNL because Spring's own view layer uses SpEL, so declare it here. -->
        <dependency>
            <groupId>ognl</groupId>
            <artifactId>ognl</artifactId>
            <version>${ognl.version}</version>
        </dependency>

        <!-- HTML sanitisation for inbound mail bodies rendered in the console -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

        <!-- Renders the XHTML invoice to a PDF. Tax invoices have to be a fixed-layout
             document, not a web page the recipient's browser may reflow. -->
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>${openhtmltopdf.version}</version>
        </dependency>

        <!-- One JSON object per log line, so a log shipper can index fields instead of
             regex-parsing a human-formatted message. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash.encoder.version}</version>
        </dependency>

        <!-- Object storage for attachments and raw MIME -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${awssdk.version}</version>
        </dependency>

        <!-- Bulk transactional mail transport -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sesv2</artifactId>
            <version>${awssdk.version}</version>
        </dependency>

        <!-- Platform ops hub: Cost Explorer, EC2 inventory, CloudWatch CPU -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>costexplorer</artifactId>
            <version>${awssdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ec2</artifactId>
            <version>${awssdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatch</artifactId>
            <version>${awssdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>rds</artifactId>
            <version>${awssdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>elasticache</artifactId>
            <version>${awssdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ecr</artifactId>
            <version>${awssdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ses</artifactId>
            <version>${awssdk.version}</version>
        </dependency>

        <!-- API docs -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Boilerplate -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <!--
          The per-technology test starters replace the single spring-boot-starter-test, which they all
          bring transitively anyway. Not cosmetic: in Boot 4 the test auto-configuration ships beside
          each technology, so @WithMockUser and the rest need spring-boot-starter-security-test on the
          classpath to do anything at all, and the old arrangement left them quietly inert.
        -->
        <!--
          Kept after the Boot 4 upgrade rather than removed with it. Boot ignores a configuration key
          it no longer recognises without saying anything, so a renamed property does not fail, it just
          silently reverts to the default — which is how server.error.include-stacktrace stopped being
          configured here and nothing noticed. Test scope, so it costs production nothing and reports
          in the build instead.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-properties-migrator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          testcontainers- prefixes, because org.testcontainers:postgresql stops at 1.21.4 and does not
          exist at 2.x. ${testcontainers.version} is inherited from the Boot parent so the modules
          match the Testcontainers that Boot's own test support was built against; Boot sets the
          property but does not manage these artifacts, hence the explicit version.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      Where com.prabhix:identity-spring-boot-starter comes from. GitHub Packages requires a token
      even for reads: CI authenticates through actions/setup-java with server-id `github`, and a
      laptop through a <server><id>github</id> entry in ~/.m2/settings.xml. The offline path is
      `mvn -f Identity/client/pom.xml install`, which puts the same artifact in the local repository
      and makes this entry irrelevant. Maven Central is still consulted first for everything else.
    -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/prabhixtechnologies/Identity</url>
        </repository>
    </repositories>

    <build>
        <finalName>prabhix-platform</finalName>
        <!-- Overridable so concurrent builds (parallel CI jobs, several agents working the
             same checkout) do not fight over one target/classes: mvn -Dbuild.dir=target-x -->
        <directory>${build.dir}</directory>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
              Resolves dependency paths into properties named groupId:artifactId:type, which is how
              surefire below finds the Mockito jar to pass as an agent. Bound to `initialize`, before
              anything reads the property.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-agent-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>integration</excludedGroups>
                    <!--
                      Mockito's inline mock maker instruments classes through a Byte Buddy agent, and
                      by default it attaches that agent to the JVM it is already running in. The JDK
                      has warned about self-attachment since 21 and will refuse it; loading the agent
                      at startup instead is the supported way and is not going to stop working.

                      Passing mockito-core itself is correct — it declares the Premain-Class, and
                      hands off to the byte-buddy-agent on its own classpath.

                      No @{argLine} prefix on purpose. It would matter if another plugin set argLine
                      first, and nothing here does; written speculatively it breaks the build instead,
                      because surefire leaves an unresolved @{...} in place and the JVM then treats it
                      as the name of a class to run.
                    -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Production still targets 25. Maven on many laptops uses JAVA_HOME 17, which cannot
          emit release 25. Below 25, emit 17 bytecode; a 25 runtime still gets JVM features.
        -->
        <profile>
            <id>jdk-below-25</id>
            <activation>
                <jdk>[1.8,25)</jdk>
            </activation>
            <properties>
                <java.version>17</java.version>
            </properties>
        </profile>
        <!-- mvn test -Pintegration  → also runs Testcontainers-backed tests -->
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <!--
                          Merged with the base configuration rather than replacing it, so the Mockito
                          agent set there applies here too. The override that used to be on this
                          element replaced the whole block, which silently dropped the agent for
                          exactly the tests most likely to need it.

                          The inner override is the one that does the work: it clears excludedGroups,
                          which is what admits the Testcontainers tests. An empty element without it
                          would merge to nothing and change no behaviour at all.
                        -->
                        <configuration>
                            <excludedGroups combine.self="override"/>
                            <environmentVariables>
                                <DOCKER_HOST>${testcontainers.docker.host}</DOCKER_HOST>
                                <!--
                                  Ryuk bind-mounts the daemon socket from inside a Linux container,
                                  so this is the in-container path. Without it Ryuk tries to mount
                                  the Windows pipe path and Docker rejects it as an invalid path.
                                -->
                                <TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Docker Desktop on Windows publishes several named pipes and Testcontainers' auto-detection
          picks docker_engine, which answers HTTP 400. The Linux engine pipe is the working one.
          Testcontainers only honours docker.host from ~/.testcontainers.properties, not from the
          classpath, so it has to arrive as an environment variable instead.
        -->
        <profile>
            <id>docker-host-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <testcontainers.docker.host>npipe:////./pipe/dockerDesktopLinuxEngine</testcontainers.docker.host>
            </properties>
        </profile>
        <profile>
            <id>docker-host-unix</id>
            <activation>
                <os><family>unix</family></os>
            </activation>
            <properties>
                <testcontainers.docker.host>unix:///var/run/docker.sock</testcontainers.docker.host>
            </properties>
        </profile>

        <!--
          Writes backend/apidocs.json from a running instance. The plugin is an HTTP client, not a
          compiler: springdoc has to be serving /v3/api-docs (SWAGGER_ENABLED=true) or this is a
          connection error rather than an empty file.

            $env:SWAGGER_ENABLED='true'; mvn spring-boot:run
            mvn -Pgenerate-openapi springdoc-openapi:generate
        -->
        <profile>
            <id>generate-openapi</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springdoc</groupId>
                        <artifactId>springdoc-openapi-maven-plugin</artifactId>
                        <version>1.5</version>
                        <configuration>
                            <apiDocsUrl>http://localhost:8080/v3/api-docs</apiDocsUrl>
                            <outputFileName>apidocs.json</outputFileName>
                            <outputDir>${project.basedir}</outputDir>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
